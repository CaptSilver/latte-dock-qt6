*~
!.arcconfig
!.gitignore

# Ignore hidden files
.directory

# build directory
/build*/
/cmake-build*

# backup files. *~ above already catches every foo.ext~ and .foo.ext~ an editor
# leaves behind, so only the non-tilde leftovers need naming here.
*.autosave
*.kate-swp
*.*.user
*.*.orig
*.rej

# locale files. locale/ is what ki18n_install(po) writes when the tree is
# configured in-source; the .po sources it compiles from stay tracked under po/.
*.mo
/locale/

# KDevelop Project files
*.kdev4

!*.layout.latte

CMakeLists.txt.user*
/compile_commands.json

# Python bytecode and pytest state
__pycache__/
.pytest_cache/

# In-source CMake output. This tree gets configured at the repo root as often as
# in a build/ subdirectory, so generated files land right beside the sources they
# came from. Anything below that a loose glob would also match a real tracked
# source is anchored or spelled out in full: Makefile, types.h, generictools.*
# and contextmenudata.h all exist in both forms.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
ecm_uninstall.cmake
install_manifest.txt
Makefile
!.copr/Makefile
/Testing/
/.qt/
/bin/
/lib/
/prefix.sh
/FindQtQuick-QMLModule.cmake
/FindQtQuick.Layouts-QMLModule.cmake

# moc, uic and the Wayland scanner. tests/__/ is where the test targets' autogen
# tree lands, out of a relative path in their include dirs.
*_autogen/
/tests/__/
moc_*.cpp
moc_*.cpp_parameters
ui_*.h
qwayland-*.cpp
qwayland-*.h
wayland-*-client-protocol.h
wayland-*-protocol.c

# Configured headers, the D-Bus adaptor, and the desktop/appdata files built from
# the .cmake templates next to them.
/app/config-latte.h
/app/coretypes.h
/app/lattedockadaptor.cpp
/app/lattedockadaptor.h
/app/org.kde.latte-dock.appdata.xml
/app/org.kde.latte-dock.desktop
/containment/plugin/lattetypes.h
/declarativeimports/core/config-latte-lib.h

# Build-time copies of tracked sources, and kcfg output. Full paths only -- each
# of these names a real file somewhere else in the tree.
/containmentactions/contextmenu/contextmenudata.h
/containmentactions/contextmenu/generictools.cpp
/containmentactions/contextmenu/generictools.h
/declarativeimports/core/types.h
/plasmoid/kactivitymanagerd_plugins_settings.cpp
/plasmoid/kactivitymanagerd_plugins_settings.h
/tests/kactivitymanagerd_plugins_settings.cpp
/tests/kactivitymanagerd_plugins_settings.h

# Coverage counters from an instrumented run.
*.profraw

# Scene-probe per-run output. Only lands in the tree when the artifact dir is
# pointed at it; the blessed .expected.<device>.png baselines beside it stay
# tracked, so nothing here may match those.
*.actual.png
*.diff.png

